# REVIEW-ONLY Nginx server snippet. Not installed or deployed.
# __PRIVATE_VPN_IP__ must be the verified address on a VPN/private-only interface.
# __STAGING_FQDN__ must be a verified private-access FQDN with approved valid TLS.
# This is NOT an authentication gateway: access control comes from an approved VPN
# plus OCI NSG/security lists, OS firewall and actual listener verification.
# Do not bind wildcard/public IPv4 or IPv6; no public DNS-only security assumption.
server {
    listen __PRIVATE_VPN_IP__:443 ssl;
    server_name __STAGING_FQDN__;
    server_tokens off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /etc/quddam-staging/tls/fullchain.pem;
    ssl_certificate_key /etc/quddam-staging/tls/privkey.pem;

    # Reject unrelated Host values, including requests hitting the private IP.
    if ($host != __STAGING_FQDN__) { return 421; }

    client_max_body_size 1m;  # confirm product request sizes before acceptance
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host __STAGING_FQDN__;
        proxy_set_header X-Forwarded-Host __STAGING_FQDN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        # AUTH_TRUST_PROXY=false. Drop incoming client-supplied identity headers.
        proxy_set_header X-Quddam-Client-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_buffering off; # preserve SSE delivery
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 5s;
    }
}
