# REVIEW-ONLY template: do not install/enable until owner approves OCI topology/cost.
# Operator must verify /usr/bin/node is Node 24.19.0 on target ARM64 and
# /opt/quddam-staging/qalba-platform is an immutable, approved build checkout.
# Create /etc/quddam-staging/app.env outside Git with root:root, mode 0600.
# Create .next/cache before enabling; owner/operator must test all runtime writes.
[Unit]
Description=Quddam private staging Next.js (review-only template)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quddam-staging
Group=quddam-staging
WorkingDirectory=/opt/quddam-staging/qalba-platform
Environment=NODE_ENV=production
EnvironmentFile=/etc/quddam-staging/app.env
ExecStart=/usr/bin/node scripts/start-staging.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
StateDirectory=quddam-staging
CacheDirectory=quddam-staging
ReadWritePaths=/opt/quddam-staging/qalba-platform/.next/cache
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
