 title String @db.VarChar(180)
 normalizedTitle String @unique @db.VarChar(180)
 scenario String @db.VarChar(800)
 prosecutionPrompt String @db.VarChar(400)
 defensePrompt String @db.VarChar(400)
 rebuttalPrompt String? @db.VarChar(300)
 categoryId String
 difficulty Difficulty @default(EASY)
 locale String @default("ar-SA") @db.VarChar(10)
 status QuestionStatus @default(DRAFT)
 contentRating String @default("FICTIONAL_PARTY") @db.VarChar(30)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 category Category @relation(fields:[categoryId],references:[id])
 facts CourtCaseFact[]
 rounds CourtRound[]
 @@index([status,locale,categoryId,difficulty])
}
