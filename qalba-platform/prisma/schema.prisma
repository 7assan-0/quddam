/// Dedicated Lightning content. Never sent as a complete match bank.
model LightningQuestion {
  id String @id @default(cuid())
  question String @db.VarChar(500)
  normalizedQuestion String @unique @db.VarChar(500)
  answer String @db.VarChar(160)
  alternativeAnswers String[]
  categoryId String
  difficulty Difficulty @default(EASY)
  locale String @default("ar-SA") @db.VarChar(10)
  status QuestionStatus @default(DRAFT)
  explanation String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category Category @relation(fields:[categoryId],references:[id])
  uses LightningQuestionUse[]
  @@index([status,locale,categoryId,difficulty])
}

