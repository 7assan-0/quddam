{
  "name": "qalba-party-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "overrides": {
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node --import tsx scripts/start-production.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "test:party": "node scripts/party-integration.mjs",
    "test:checkout": "node scripts/checkout-integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:db": "node scripts/e2e-with-db.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:billing:postgres": "node --import tsx scripts/billing-settlement-postgres.ts",
    "content:validate": "node --import tsx scripts/content-validate.ts",
    "content:remediate": "node --import tsx scripts/content-remediate.ts",
    "ops:validate": "node --import tsx scripts/production-env.ts",
    "ops:bootstrap-admin": "node --import tsx scripts/bootstrap-admin.ts",
    "db:seed:content": "node --import tsx prisma/seed.ts --content-only"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/qrcode": "^1.5.5",
    "next": "16.3.6",
    "nodemailer": "10.0.12",
    "pg": "8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.1.12",
    "@next/env": "16.3.6",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.5",
    "@electric-sql/pglite-socket": "0.1.5",
    "@playwright/test": "1.56.1",
    "@types/node": "24.9.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "axe-core": "^4.13.0",
    "dotenv": "17.2.3",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.6",
    "prisma": "7.10.0",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "vitest": "4.0.4"
  }
}
