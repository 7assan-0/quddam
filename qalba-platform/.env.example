DATABASE_URL="postgresql://qalba:qalba@localhost:5432/qalba?schema=public"
DATABASE_POOL_MAX="10"
AUTH_RATE_LIMIT_SECRET="replace-with-a-long-random-secret"
# Enable only behind an ingress that overwrites this header and blocks direct access.
AUTH_TRUST_PROXY="false"
AUTH_CLIENT_IP_HEADER=""
# Existing welcome-credits flag and configured count also remain required.
PUBLIC_WELCOME_CREDITS_ENABLED="false"
APP_URL="http://localhost:3000"
MOYASAR_SECRET_KEY=""
MOYASAR_CALLBACK_TOKEN=""
BILLING_CRON_SECRET=""
ANALYTICS_CRON_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_USER_EMAIL=""
SEED_USER_PASSWORD=""
# One-time first-admin secret-manager input; clear after bootstrap.
# Existing ADMIN makes ops:bootstrap-admin a no-op without credential changes.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
# HTTP origin and sample database password above are LOCAL examples only.
# Production uses HTTPS, distinct credentials, ops:validate and content-only seed.
# Optional exact HTTPS origins for authored external question images, comma separated.
# Empty keeps browser resources self-hosted; no payment/analytics browser origins needed.
CSP_IMAGE_ORIGINS=""
